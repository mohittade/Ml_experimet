import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.linear_model import LogisticRegression
import numpy as np

# Load Iris data
iris = load_iris()
X = iris.data[:100, :2]     # Take first 100 samples (Setosa & Versicolor)
y = iris.target[:100]       # Labels: 0 or 1

# Train logistic regression
model = LogisticRegression()
model.fit(X, y)

# Predict on the same data
y_pred = model.predict(X)

print("Accuracy:", model.score(X, y))

# Plot data points
plt.scatter(X[:, 0], X[:, 1], c=y, cmap='bwr', label='Data Points')

# Create a grid for decision boundary
x_min, x_max = X[:, 0].min()-1, X[:, 0].max()+1
y_min, y_max = X[:, 1].min()-1, X[:, 1].max()+1
xx, yy = np.meshgrid(np.linspace(x_min, x_max, 200),
                     np.linspace(y_min, y_max, 200))

Z = model.predict(np.c_[xx.ravel(), yy.ravel()])
Z = Z.reshape(xx.shape)

# Plot decision boundary
plt.contourf(xx, yy, Z, alpha=0.2, cmap='bwr')

plt.xlabel("Sepal Length")
plt.ylabel("Sepal Width")
plt.title("Logistic Regression on Iris (Setosa vs Versicolor)")
plt.grid(True)
plt.show()
